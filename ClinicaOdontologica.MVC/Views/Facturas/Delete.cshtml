@model Clinica_odontologia.Models01.Facturas

@{
    ViewData["Title"] = "Eliminar Factura";
}

<h1>Eliminar</h1>
<h3>¿Está seguro de que desea eliminar esta factura?</h3>

<div>
    <h4>Factura</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Fecha de emisión
        </dt>
        <dd class="col-sm-9">
            @Model.Fecha_emision.ToString("dd/MM/yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">
            Subtotal
        </dt>
        <dd class="col-sm-9">
            @Model.Subtotal.ToString("C")
        </dd>

        <dt class="col-sm-3">
            Impuesto
        </dt>
        <dd class="col-sm-9">
            @Model.Impuestos.ToString("C")
        </dd>

        <dt class="col-sm-3">
            Total
        </dt>
        <dd class="col-sm-9">
            @Model.Total.ToString("C")
        </dd>

        <dt class="col-sm-3">
            Estado de pago
        </dt>
        <dd class="col-sm-9">
            @Model.Estado_pago
        </dd>

        <dt class="col-sm-3">
            Cita / Paciente
        </dt>
        <dd class="col-sm-9">
            @(Model.citas != null && Model.citas.paciciente != null ? Model.citas.paciciente.Nombres : "Sin asignar")
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-3">
        <input type="hidden" asp-for="IdFactura" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>