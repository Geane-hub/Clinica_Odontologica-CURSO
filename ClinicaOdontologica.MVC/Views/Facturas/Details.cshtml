@model Clinica_odontologia.Models01.Facturas

@{
    ViewData["Title"] = "Detalles de la factura";
}

<h1>Detalles de la factura</h1>

<div>
    <h4>Facturas</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Fecha de emision
        </dt>
        <dd class="col-sm-10">
            @Model.Fecha_emision.ToString("dd/MM/yyyy HH:mm")
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Subtotal
        </dt>
        <dd class = "col-sm-10">
            @Model.Subtotal
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Impuesto
        </dt>
        <dd class = "col-sm-10">
            @Model.Impuestos
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Total
        </dt>
        <dd class = "col-sm-10">
            @Model.Total
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Estado_pago
        </dt>
        <dd class = "col-sm-10">
            @Model.Estado_pago
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Citas
        </dt>
        <dd class = "col-sm-10">
            @(Model.citas != null && Model.citas.paciciente != null ? Model.citas.paciciente.Nombres : "Sin asignar")
        </dd>

</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdFactura">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
