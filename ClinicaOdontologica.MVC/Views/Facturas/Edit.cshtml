@model Clinica_odontologia.Models01.Facturas

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Facturas</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdFactura" />
            <div class="form-group">
                <label asp-for="Fecha_emision" class="control-label"></label>
                <input asp-for="Fecha_emision" class="form-control" />
                <span asp-validation-for="Fecha_emision" class="text-danger"></span>
            </div>

            <!--Subtortal-->
            <div class="form-group">
                <label asp-for="Subtotal" class="control-label">
                    Subtotal
                </label>

                <input asp-for="Subtotal"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Subtotal"
                      class="text-danger"></span>
            </div>

            <!--Impuestos-->
            <div class="form-group">
                <label asp-for="Impuestos" class="control-label">
                    Costo
                </label>

                <input asp-for="Impuestos"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Impuestos"
                      class="text-danger"></span>
            </div>

            <!--Total-->
            <div class="form-group">
                <label asp-for="Total" class="control-label">
                    Costo
                </label>

                <input asp-for="Total"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Total"
                      class="text-danger"></span>
            </div> 

            <!--Estado de pago-->
            <div class="form-group">
                <label asp-for="Estado_pago" class="control-label">
                    Estado
                </label>

                <select asp-for="Estado_pago" class="form-control">
                    <option value="">Seleccione un estado</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Confirmada">Acreditado</option>
                    <option value="Atendida">Rechazado</option>
                </select>

                <span asp-validation-for="Estado_pago"
                      class="text-danger"></span>
            </div>

            <!--IDcita-->
            <div class="form-group">
                <label asp-for="IdCita" class="control-label">
                    Cita
                </label>

                <select asp-for="IdCita"
                        class="form-control"
                        asp-items="ViewBag.IdCita">

                    <option value="">Seleccione una cita</option>

                </select>

                <span asp-validation-for="IdCita" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
