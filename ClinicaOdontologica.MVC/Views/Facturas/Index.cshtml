@model IEnumerable<Clinica_odontologia.Models01.Facturas>

@{
    ViewData["Title"] = "Index";
}

<h1>Gestión de Facturas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Crear nueva factura
    </a>
</p>

<table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
        <tr>
            <th>Fecha_emision</th>
            <th>Subtotal</th>
            <th>Impuestos</th>
            <th>Total</th>
            <th>Estado_pago</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Fecha_emision
                </td>

                <td>
                    @item.Subtotal
                </td>

                <td>
                    @item.Impuestos
                </td>

                <td>
                    @item.Total
                </td>

                <td>
                    @item.Estado_pago
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdFactura">
                        Editar
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.IdFactura">
                        Detalles
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.IdFactura">
                        Eliminar
                    </a>
                </td>

            </tr>
        }
    </tbody>

</table>
