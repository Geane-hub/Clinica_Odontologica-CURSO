}

<h1>Details</h1>

<div>
    <h4>HistorialMedico</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Alergias
        </dt>
        <dd class = "col-sm-10">
            @Model.Alergias
        </dd>
    </dl>
