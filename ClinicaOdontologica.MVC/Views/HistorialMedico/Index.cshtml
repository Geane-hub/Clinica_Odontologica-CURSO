@model IEnumerable<Clinica_odontologia.Models01.HistorialMedico>

@{
    ViewData["Title"] = "Historial Médico";
}

<h1>Historial Médico</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Alergias</th>
            <th>Enfermedades previas</th>
            <th>Tipo de sangre</th>
            <th>Paciente</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Alergias
                </td>

                <td>
                    @item.Enfermedades_previas
                </td>

                <td>
                    @item.Tipo_sangre
                </td>

                <td>
                    @(item.paciente != null
                        ? $"{item.paciente.Nombres} {item.paciente.Apellidos}"
                        : "Sin asignar")
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.idHistorialMedico">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.idHistorialMedico">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.idHistorialMedico">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>