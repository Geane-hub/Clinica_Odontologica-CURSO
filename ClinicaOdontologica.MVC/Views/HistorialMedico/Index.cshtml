@model IEnumerable<Clinica_odontologia.Models01.HistorialMedico>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Alergias)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Enfermedades_previas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo_sangre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdPaciente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.paciente)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Alergias)
            </td>
            <td>
                @Html.DisplayFor(model => item.Enfermedades_previas)
            </td>
            <td>
                @Html.DisplayFor(model => item.Tipo_sangre)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdPaciente)
            </td>
            <td>
                @Html.DisplayFor(model => item.paciente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idHistorialMedico">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.idHistorialMedico">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.idHistorialMedico">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
