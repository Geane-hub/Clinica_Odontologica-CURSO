@model Clinica_odontologia.Models01.HistorialMedico

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>Esta seguro que desea eliminar el Historial medico?</h3>
<div>
    <h4>Clinica_odontologia.Models01.HistorialMedico</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Alergias
        </dt>
        <dd class = "col-sm-10">
            @Model.Alergias
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Enfermedades_previas
        </dt>
        <dd class = "col-sm-10">
            @Model.Enfermedades_previas
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Tipo_sangre
        </dt>
        <dd class = "col-sm-10">
            @Model.Tipo_sangre
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Paciente
        </dt>
        <dd class = "col-sm-10">
            @Model.paciente
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="idHistorialMedico" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
