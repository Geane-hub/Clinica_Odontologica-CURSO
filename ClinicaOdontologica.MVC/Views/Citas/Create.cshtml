@model Clinica_odontologia.Models01.Citas

@{
    ViewData["Title"] = "Crear Cita";
}

<h1>Crear Cita</h1>

<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Fecha_cita" class="control-label"></label>
                <input asp-for="Fecha_cita" class="form-control" />
                <span asp-validation-for="Fecha_cita" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Motivo" class="control-label"></label>
                <input asp-for="Motivo" class="form-control" />
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>
 
            <div class="form-group">
                <label asp-for="IdPaciente" class="control-label">
                    Paciente
                </label>

                <select asp-for="IdPaciente" class="form-control"
                        asp-items="ViewBag.IdPaciente">
                    <option value="">Seleccione un paciente</option>
                </select>

                <span asp-validation-for="IdPaciente"
                      class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="IdOdontologo" class="control-label">
                    Odontólogo
                </label>

                <select asp-for="IdOdontologo" class="form-control"
                        asp-items="ViewBag.IdOdontologo">
                    <option value="">Seleccione un odontólogo</option>
                </select>

                <span asp-validation-for="IdOdontologo"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdConsultorio" class="control-label">
                    Consultorio
                </label>

                <select asp-for="IdConsultorio"
                        class="form-control"
                        asp-items="ViewBag.IdConsultorio">
                    <option value="">Seleccione un consultorio</option>
                </select>

                <span asp-validation-for="IdConsultorio"
                      class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit" value="Crear Cita"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>