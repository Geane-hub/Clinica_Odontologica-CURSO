@model Clinica_odontologia.Models01.Citas

@{
    ViewData["Title"] = "Detalles de la cita";
}

<h1>Detalles de la cita</h1>

<div>
    <h4>Información de la cita</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Fecha y hora
        </dt>
        <dd class="col-sm-10">
            @Model.Fecha_cita.ToString("dd/MM/yyyy HH:mm")
        </dd>

        <dt class="col-sm-2">
            Motivo
        </dt>
        <dd class="col-sm-10">
            @Model.Motivo
        </dd>

        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Model.Estado_cita
        </dd>

        <dt class="col-sm-2">
            Paciente
        </dt>
        <dd class="col-sm-10">
            @(Model.paciciente != null
                ? $"{Model.paciciente.Nombres} {Model.paciciente.Apellidos}"
                : "Sin asignar")
        </dd>

        <dt class="col-sm-2">
            Odontólogo
        </dt>
        <dd class="col-sm-10">
            @(Model.odontologo != null
                ? $"Dr. {Model.odontologo.Nombre} {Model.odontologo.Apellido}"
                : "Sin asignar")
        </dd>

        <dt class="col-sm-2">
            Consultorio
        </dt>
        <dd class="col-sm-10">
            @(Model.consultorio != null
                ? Model.consultorio.NumeroSala
                : "Sin asignar")
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.Id_cita"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>
</div>