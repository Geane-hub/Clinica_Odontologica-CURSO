@model IEnumerable<Clinica_odontologia.Models01.Citas>

@{
    ViewData["Title"] = "Gestión de Citas";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Fecha y Hora</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Paciente</th>
            <th>Odontologo</th>
            <th>Consultorio</th>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Fecha_cita.ToString("dd/mm/yyyy HH:mm")</td>
            <td>@item.Motivo</td>
            <td>
                @(item.paciciente != null ? $"{item.paciciente.Nombres} {item.paciciente.Apellidos}" : "Sin Asignar");
            </td>

            <td>
                @(item.odontologo != null ? $"Dr.{item.odontologo.Nombre} {item.odontologo.Apellido}" : "Sin Asignar");
            </td>

            <td>
                @(item.consultorio != null ? item.consultorio.NumeroSala : "Sin Consultor");
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id_cita">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id_cita">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id_cita">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
