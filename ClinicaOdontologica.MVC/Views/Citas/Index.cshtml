@model IEnumerable<Clinica_odontologia.Models01.Citas>

@{
    ViewData["Title"] = "Gestión de Citas";
}

<h1>Gestión de Citas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nueva cita</a>
</p>

<table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
        <tr>
            <th>Fecha y Hora</th>
            <th>Motivo</th>
            <th>Estado</th>
            <th>Paciente</th>
            <th>Odontólogo</th>
            <th>Consultorio</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Fecha_cita.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @item.Motivo
                </td>

                <td>
                    @item.Estado_cita
                </td>

                <td>
                    @(item.paciciente != null
                        ? $"{item.paciciente.Nombres} {item.paciciente.Apellidos}"
                        : "Sin asignar")
                </td>

                <td>
                    @(item.odontologo != null
                        ? $"Dr. {item.odontologo.Nombre} {item.odontologo.Apellido}"
                        : "Sin asignar")
                </td>

                <td>
                    @(item.consultorio != null
                        ? item.consultorio.NumeroSala
                        : "Sin asignar")
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id_cita">
                        Editar
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.Id_cita">
                        Detalles
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id_cita">
                        Eliminar
                    </a>
                </td>

            </tr>
        }

    </tbody>
</table>