@model Clinica_odontologia.Models01.Citas

@{
    ViewData["Title"] = "Eliminar cita";
}

<h1>Eliminar cita</h1>

<h3>¿Está seguro de que desea eliminar esta cita?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Fecha y hora
        </dt>
        <dd class="col-sm-10">
            @Model.Fecha_cita.ToString("dd/MM/yyyy HH:mm")
        </dd>

        <dt class="col-sm-2">
            Motivo
        </dt>
        <dd class="col-sm-10">
            @Model.Motivo
        </dd>

        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Model.Estado_cita
        </dd>

        <dt class="col-sm-2">
            Paciente
        </dt>
        <dd class="col-sm-10">
            @(Model.paciciente != null
                ? $"{Model.paciciente.Nombres} {Model.paciciente.Apellidos}"
                : "Sin asignar")
        </dd>

        <dt class="col-sm-2">
            Odontólogo
        </dt>
        <dd class="col-sm-10">
            @(Model.odontologo != null
                ? $"Dr. {Model.odontologo.Nombre} {Model.odontologo.Apellido}"
                : "Sin asignar")
        </dd>

        <dt class="col-sm-2">
            Consultorio
        </dt>
        <dd class="col-sm-10">
            @(Model.consultorio != null
                ? Model.consultorio.NumeroSala
                : "Sin asignar")
        </dd>

    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id_cita" />

        <input type="submit"
               value="Eliminar cita"
               class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>