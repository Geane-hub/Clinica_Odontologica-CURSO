@model Clinica_odontologia.Models01.Paciente

@{
    ViewData["Title"] = "Editar Paciente";
}

<h1>Editar Paciente</h1>

<h4>Paciente</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- ID del paciente -->
            <input type="hidden" asp-for="IdPaciente" />

            <!-- Cédula -->
            <div class="form-group">
                <label asp-for="Dni" class="control-label">
                    Cédula
                </label>
                <input asp-for="Dni"
                       class="form-control"
                       maxlength="10"
                       inputmode="numeric" />
                <span asp-validation-for="Dni"
                      class="text-danger"></span>
            </div>

            <!-- Nombres -->
            <div class="form-group">
                <label asp-for="Nombres" class="control-label">
                    Nombres
                </label>
                <input asp-for="Nombres"
                       class="form-control" />
                <span asp-validation-for="Nombres"
                      class="text-danger"></span>
            </div>

            <!-- Apellidos -->
            <div class="form-group">
                <label asp-for="Apellidos" class="control-label">
                    Apellidos
                </label>
                <input asp-for="Apellidos"
                       class="form-control" />
                <span asp-validation-for="Apellidos"
                      class="text-danger"></span>
            </div>

            <!-- Fecha de nacimiento -->
            <div class="form-group">
                <label asp-for="FechaNacimiento" class="control-label">
                    Fecha de nacimiento
                </label>
                <input asp-for="FechaNacimiento"
                       type="date"
                       class="form-control"
                       asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="FechaNacimiento"
                      class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label asp-for="Email" class="control-label">
                    Correo electrónico
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <!-- Teléfono -->
            <div class="form-group">
                <label asp-for="Telefono" class="control-label">
                    Teléfono
                </label>
                <input asp-for="Telefono"
                       class="form-control"
                       maxlength="10"
                       inputmode="numeric" />
                <span asp-validation-for="Telefono"
                      class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Guardar cambios"
                       class="btn btn-primary w-100" />
            </div>

        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}