@model Clinica_odontologia.Models01.Paciente

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Paciente</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Dni
        </dt>
        <dd class = "col-sm-10">
            @Model.Dni
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Nombres
        </dt>
        <dd class = "col-sm-10">
            @Model.Nombres
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Apellidos
        </dt>
        <dd class = "col-sm-10">
            @Model.Apellidos
        </dd>
    </dl>
        <dt class = "col-sm-2">
             FechaNacimiento
        </dt>
        <dd class = "col-sm-10">
            @Model.FechaNacimiento
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Email
        </dt>
        <dd class = "col-sm-10">
            @Model.Email
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Telefono
        </dt>
        <dd class = "col-sm-10">
            @Model.Telefono
        </dd>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdPaciente">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
