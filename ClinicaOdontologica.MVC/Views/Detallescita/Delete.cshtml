@model Clinica_odontologia.Models01.Detallescita

@{
    ViewData["Title"] = "Eliminar detalle de cita";
}

<h1>Eliminar detalle de cita</h1>

<h3>¿Está seguro de que desea eliminar este detalle?</h3>

<div>
    <h4>Detalle de cita</h4>
    <hr />

    <dl class="row">

        <!-- TRATAMIENTO -->
        <dt class="col-sm-3">
            Tratamiento
        </dt>

        <dd class="col-sm-9">
            @Model.Tratamiento?.NombreTratamiento
        </dd>


        <!-- COSTO -->
        <dt class="col-sm-3">
            Costo
        </dt>

        <dd class="col-sm-9">
            @Model.Costo_aplicado
        </dd>


        <!-- OBSERVACIONES -->
        <dt class="col-sm-3">
            Observaciones
        </dt>

        <dd class="col-sm-9">
            @Model.Observaciones
        </dd>

    </dl>

    <form asp-action="Delete">

        <input type="hidden" asp-for="IdDetallecita" />

        <input type="submit"
               value="Eliminar"
               class="btn btn-danger" />

        |

        <a asp-action="Index">
            Cancelar
        </a>

    </form>
</div>