@model Clinica_odontologia.Models01.Detallescita

@{
    ViewData["Title"] = "Detalle de la cita";
}

<h1>Detalle de la cita</h1>

<div>
    <h4>Información del detalle</h4>
    <hr />

    <dl class="row">

        <!-- TRATAMIENTO -->
        <dt class="col-sm-3">
            Tratamiento
        </dt>

        <dd class="col-sm-9">
            @Model.Tratamiento?.NombreTratamiento
        </dd>


        <!-- COSTO -->
        <dt class="col-sm-3">
            Costo
        </dt>

        <dd class="col-sm-9">
            @Model.Costo_aplicado
        </dd>


        <!-- OBSERVACIONES -->
        <dt class="col-sm-3">
            Observaciones
        </dt>

        <dd class="col-sm-9">
            @Model.Observaciones
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdDetallecita">
        Editar
    </a>
    |
    <a asp-action="Index">
        Volver a la lista
    </a>
</div>