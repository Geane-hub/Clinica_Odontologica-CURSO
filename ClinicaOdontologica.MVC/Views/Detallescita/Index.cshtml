@model IEnumerable<Clinica_odontologia.Models01.Detallescita>

@{
    ViewData["Title"] = "Detalles de Cita";
}

<h1>Detalles de Cita</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo detalle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Tratamiento</th>
            <th>Costo</th>
            <th>Observaciones</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Tratamiento?.NombreTratamiento
                </td>
                <td>
                    @item.Costo_aplicado
                </td>
                <td>
                    @item.Observaciones
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdDetallecita">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdDetallecita">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdDetallecita">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>