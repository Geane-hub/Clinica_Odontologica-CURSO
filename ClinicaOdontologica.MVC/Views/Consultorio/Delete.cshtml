@model Clinica_odontologia.Models01.Consultorio

@{
    ViewData["Title"] = "Eliminar Consultorio";
}

<h1>Eliminar Consultorio</h1>

<h3>¿Está seguro de que desea eliminar este consultorio?</h3>

<div>
    <h4>Información del consultorio</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Número de sala
        </dt>
        <dd class="col-sm-10">
            @Model.NumeroSala
        </dd>

        <dt class="col-sm-2">
            Piso
        </dt>
        <dd class="col-sm-10">
            @Model.Piso
        </dd>

        <dt class="col-sm-2">
            Equipamiento principal
        </dt>
        <dd class="col-sm-10">
            @Model.EquipamientoPrincipal
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="IdConsultorio" />

        <input type="submit"
               value="Eliminar consultorio"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>
</div>