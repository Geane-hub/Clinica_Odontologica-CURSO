@model IEnumerable<Clinica_odontologia.Models01.Consultorio>

@{
    ViewData["Title"] = "Gestión de Consultorios";
}

<h1>Gestión de Consultorios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Crear nuevo consultorio
    </a>
</p>

<table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
        <tr>
            <th>Número de sala</th>
            <th>Piso</th>
            <th>Equipamiento principal</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.NumeroSala
                </td>

                <td>
                    @item.Piso
                </td>

                <td>
                    @item.EquipamientoPrincipal
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.IdConsultorio">
                        Editar
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@item.IdConsultorio">
                        Detalles
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.IdConsultorio">
                        Eliminar
                    </a>
                </td>

            </tr>
        }
    </tbody>

</table>