@model Clinica_odontologia.Models01.Consultorio

@{
    ViewData["Title"] = "Detalles del Consultorio";
}

<h1>Detalles del Consultorio</h1>

<div>
    <h4>Información del consultorio</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Número de sala
        </dt>
        <dd class="col-sm-10">
            @Model.NumeroSala
        </dd>

        <dt class="col-sm-2">
            Piso
        </dt>
        <dd class="col-sm-10">
            @Model.Piso
        </dd>

        <dt class="col-sm-2">
            Equipamiento principal
        </dt>
        <dd class="col-sm-10">
            @Model.EquipamientoPrincipal
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model?.IdConsultorio"
       class="btn btn-primary">
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver a la lista
    </a>
</div>