@model Clinica_odontologia.Models01.Consultorio

@{
    ViewData["Title"] = "Editar Consultorio";
}

<h1>Editar Consultorio</h1>

<h4>Información del consultorio</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="IdConsultorio" />

            <div class="form-group">
                <label asp-for="NumeroSala" class="control-label">
                    Número de sala
                </label>

                <input asp-for="NumeroSala"
                       class="form-control" />

                <span asp-validation-for="NumeroSala"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Piso" class="control-label">
                    Piso
                </label>

                <input asp-for="Piso"
                       class="form-control" />

                <span asp-validation-for="Piso"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EquipamientoPrincipal"
                       class="control-label">
                    Equipamiento principal
                </label>

                <input asp-for="EquipamientoPrincipal"
                       class="form-control" />

                <span asp-validation-for="EquipamientoPrincipal"
                      class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Guardar cambios"
                       class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}