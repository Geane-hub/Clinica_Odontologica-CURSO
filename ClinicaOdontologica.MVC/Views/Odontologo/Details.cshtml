@model Clinica_odontologia.Models01.Odontologo

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>Odontólogo</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Nombre
        </dt>
        <dd class="col-sm-10">
            @Model.Nombre
        </dd>

        <dt class="col-sm-2">
            Apellido
        </dt>
        <dd class="col-sm-10">
            @Model.Apellido
        </dd>

        <dt class="col-sm-2">
            Registro médico
        </dt>
        <dd class="col-sm-10">
            @Model.Registro_medico
        </dd>

        <dt class="col-sm-2">
            Especialidad
        </dt>
        <dd class="col-sm-10">
            @(Model.especialidad != null
                ? Model.especialidad.NombreEspecialidad
                : "Sin especialidad")
        </dd>

        <dt class="col-sm-2">
            Citas
        </dt>
        <dd class="col-sm-10">

            @if (Model.Citas != null && Model.Citas.Any())
            {
                <ul>
                    @foreach (var cita in Model.Citas)
                    {
                        <li>
                            Cita #@cita.Id_cita
                        </li>
                    }
                </ul>
            }
            else
            {
                <span>Este odontólogo no tiene citas registradas.</span>
            }

        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdOdontologo">
        <div class="form-group">
            <input type="submit"
                   value="Editar"
                   class="btn btn-success" />
        </div>
    </a> |
    <a asp-action="Index">
        <div class="form-group">
            <input type="submit"
                   value="Volver a la lista"
                   class="btn btn-success" />
        </div>
    </a>
</div>