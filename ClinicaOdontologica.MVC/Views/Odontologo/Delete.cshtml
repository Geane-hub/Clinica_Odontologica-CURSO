@model Clinica_odontologia.Models01.Odontologo

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Clinica_odontologia.Models01.Odontologo</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Nombre
        </dt>
        <dd class="col-sm-10">
            @Model.Nombre
        </dd>

        <dt class="col-sm-2">
            Apellido
        </dt>
        <dd class="col-sm-10">
            @Model.Apellido
        </dd>

        <dt class="col-sm-2">
            Registro médico
        </dt>
        <dd class="col-sm-10">
            @Model.Registro_medico
        </dd>

        <dt class="col-sm-2">
            Especialidad
        </dt>
        <dd class="col-sm-10">
            @(Model.especialidad != null
                ? Model.especialidad.NombreEspecialidad
                : "Sin especialidad")
        </dd>

    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdOdontologo" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
