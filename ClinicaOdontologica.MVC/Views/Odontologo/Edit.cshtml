@model Clinica_odontologia.Models01.Odontologo

@{
    ViewData["Title"] = "Editar Odontólogo";
}

<h1>Editar Odontólogo</h1>

<h4>Odontólogo</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="IdOdontologo" />

            <!-- Nombre -->
            <div class="form-group">
                <label asp-for="Nombre" class="control-label">
                    Nombre
                </label>

                <input asp-for="Nombre"
                       class="form-control"
                       placeholder="Ingrese el nombre" />

                <span asp-validation-for="Nombre"
                      class="text-danger"></span>
            </div>

            <!-- Apellido -->
            <div class="form-group">
                <label asp-for="Apellido" class="control-label">
                    Apellido
                </label>

                <input asp-for="Apellido"
                       class="form-control"
                       placeholder="Ingrese el apellido" />

                <span asp-validation-for="Apellido"
                      class="text-danger"></span>
            </div>

            <!-- Registro médico -->
            <div class="form-group">
                <label asp-for="Registro_medico" class="control-label">
                    Registro médico
                </label>

                <input asp-for="Registro_medico"
                       class="form-control"
                       placeholder="Ingrese el registro médico" />

                <span asp-validation-for="Registro_medico"
                      class="text-danger"></span>
            </div>

            <!-- Especialidad -->
            <div class="form-group">
                <label asp-for="IdEspecialidad" class="control-label">
                    Especialidad
                </label>

                <select asp-for="IdEspecialidad"
                        class="form-control"
                        asp-items="ViewBag.IdEspecialidad">

                    <option value="">
                        Seleccione una especialidad
                    </option>

                </select>

                <span asp-validation-for="IdEspecialidad"
                      class="text-danger"></span>
            </div>

            <br />

            <div class="form-group">
                <input type="submit"
                       value="Guardar cambios"
                       class="btn btn-success" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}