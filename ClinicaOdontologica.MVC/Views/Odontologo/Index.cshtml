@model IEnumerable<Clinica_odontologia.Models01.Odontologo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro_medico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdEspecialidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.especialidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Citas)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.Registro_medico)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdEspecialidad)
            </td>
            <td>
                @Html.DisplayFor(model => item.especialidad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Citas)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdOdontologo">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdOdontologo">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdOdontologo">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
