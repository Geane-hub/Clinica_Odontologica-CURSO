@model IEnumerable<Clinica_odontologia.Models01.Odontologo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Registro medico</th>
            <th>Especialidad</th>
            <th>Cita</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.Nombre != null ? $"{item.Nombre}" : "Sin asignar")
            </td>
            <td>
                 @(item.Nombre != null ? $"{item.Apellido}" : "Sin asignar")
            </td>
            <td>
                  @(item.Registro_medico != null ? $"{item.Registro_medico}" : "Sin asignar")
            </td>
            <td>
                  @(item.especialidad.NombreEspecialidad != null ? $"{item.especialidad.NombreEspecialidad}" : "Sin asignar")

            </td>
            <td>
                    @item.Citas?.FirstOrDefault()?.Motivo
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdOdontologo">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdOdontologo">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdOdontologo">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
